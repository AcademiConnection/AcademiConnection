# OpenAlex API Key (free, get from https://openalex.org/settings/api)
OPENALEX_API_KEY=your_openalex_api_key_here

# OpenAlex polite pool email (optional but recommended)
OPENALEX_EMAIL=your@email.com

# Semantic Scholar API Key (optional, increases rate limit)
# Get from https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=your_semantic_scholar_api_key_here
